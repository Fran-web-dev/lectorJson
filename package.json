{
  "name": "lector-dte-hacienda",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lector de archivos JSON/CSV DTE con exportacion Excel y conexion Hacienda El Salvador",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "perf:10k": "node scripts/perf-10k.mjs",
    "start": "electron .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.7.9",
    "electron-is-dev": "^3.0.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "sv.hacienda.lector.dte",
    "productName": "Lector DTE Hacienda",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
